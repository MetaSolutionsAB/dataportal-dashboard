# Apache: servera dashboarden med Basic Auth via .htpasswd.
# Lägg i t.ex. /etc/apache2/sites-available/dataportal-dashboard.conf och kör
#   sudo a2ensite dataportal-dashboard && sudo systemctl reload apache2
#
# Skapa lösenordsfilen utanför webbroten (första användaren med -c, därefter utan):
#   sudo htpasswd -c /etc/apache2/dataportal-dashboard.htpasswd anvandare
#
# Ingen .htaccess behövs; skyddet sätts direkt i <Directory>. Skyddet omfattar
# även status.json eftersom den ligger i samma katalog.
<VirtualHost *:443>
    ServerName dashboard.example.se
    DocumentRoot /opt/dataportal-dashboard/public

    # TLS enligt er standard (t.ex. certbot). Basic Auth utan TLS skickar lösenordet i klartext.
    # SSLEngine on
    # SSLCertificateFile ...
    # SSLCertificateKeyFile ...

    <Directory /opt/dataportal-dashboard/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require valid-user

        AuthType Basic
        AuthName "Dataportal driftstatus"
        AuthUserFile /etc/apache2/dataportal-dashboard.htpasswd
    </Directory>

    # Webbläsaren ska alltid hämta färsk status.json (kräver: sudo a2enmod headers)
    <IfModule mod_headers.c>
        <Files "status.json">
            Header set Cache-Control "no-store"
        </Files>
    </IfModule>
</VirtualHost>
