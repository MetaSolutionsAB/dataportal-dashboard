# Lösenordsskydd för dashboarden med formulärinloggning (mod_auth_form).
# Webbläsaren visar en vanlig inloggningssida (login.html) i stället för sin
# egen Basic Auth-dialog, som kan vara avstängd via företagspolicy i Edge/Chrome.
#
# Kopiera till public/.htaccess (gitignorerad), peka AuthUserFile på
# lösenordsfilen och byt SessionCryptoPassphrase till en egen lång slumpad sträng.
# Lösenordsfilen skapas utanför webbroten:
#   sudo htpasswd -c /etc/apache2/dataportal-dashboard.htpasswd anvandare
#
# Kräver på servern (en gång, som root):
#   sudo a2enmod auth_form session session_cookie session_crypto request
#   sudo systemctl restart apache2
# samt att den virtuella värden har "AllowOverride AuthConfig" (eller All) för
# katalogen, annars ignoreras filen tyst och sidan förblir öppen.
#
# Ligger dashboarden under en undersökväg, t.ex. https://server/dashboard/, ska
# AuthFormLoginRequiredLocation vara /dashboard/login.html och kakans path
# /dashboard (utan avslutande snedstreck, så att även /dashboard utan slash täcks).
#
# Byt namn på kakan (SessionCookieName) om du ändrar dess path i efterhand.
# Annars får webbläsare som redan besökt sidan två kakor med samma namn, och då
# avvisar Apache båda ("client submitted cookie more than once"): sidan laddas
# efter inloggning men style.css, app.js och status.json omdirigeras till
# login.html. Samma sak händer om lösenfrasen byts medan gamla kakor lever kvar,
# tills de gått ut efter SessionMaxAge.
#
# Kakan har flaggan Secure och skickas därför bara över https.
AuthType form
AuthName "Dataportal driftstatus"
AuthFormProvider file
AuthUserFile /etc/apache2/dataportal-dashboard.htpasswd
AuthFormLoginRequiredLocation /login.html
Session On
SessionCookieName dashboard_session path=/;HttpOnly;Secure;SameSite=Lax
SessionCryptoPassphrase byt-till-en-lang-slumpad-strang
SessionMaxAge 28800
Require valid-user

# Inloggningssidan måste gå att nå utan inloggning
<Files "login.html">
    Require all granted
</Files>
